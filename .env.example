# ==============================================================================
# Nebius AI Cloud Credentials
# ==============================================================================
# API key obtained from Nebius console (IAM / Service Account Key)
NEBIUS_API_KEY=

# Project ID from your Nebius console dashboard
NEBIUS_PROJECT_ID=

# Region where GPU resources are provisioned (e.g., eu-north1, eu-west1)
NEBIUS_REGION=eu-north1

# VPC Subnet ID inside your Nebius project for VM/endpoint deployment
NEBIUS_SUBNET_ID=

# ==============================================================================
# Hugging Face (Optional)
# ==============================================================================
# Only needed if downloading gated or private models. Leave blank for public models.
HF_TOKEN=

# ==============================================================================
# Strict Budget & Safety Guardrails ($35 Total Balance)
# ==============================================================================
# Overall hard spending cap across the entire project ($20 max out of $35 total)
MAX_BUDGET_USD=20.00

# Hard cap for any single benchmark / certification execution
MAX_PER_RUN_USD=10.00

# Default to simulator mode for all local development and integration tests
USE_SIMULATOR=true

# Model configuration
CANDIDATE_MODEL=Nemotron-3-Nano-30B
BASELINE_MODEL=Qwen3-8B
PLANNER_MODEL=Nemotron-3-Ultra
CLASSIFIER_MODEL=Nemotron-3-Nano
