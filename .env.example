# ==============================================================================
# Nebius Token Factory & Contree Sandbox Credentials
# ==============================================================================
# API key obtained from Nebius console (Token Factory / Service Account Key)
NEBIUS_API_KEY=

# Project ID from your Nebius console dashboard (used for Contree sandboxes)
NEBIUS_PROJECT_ID=

# Region (default: eu-north1)
NEBIUS_REGION=eu-north1

# ==============================================================================
# Optional Third-Party Services
# ==============================================================================
# Hugging Face token (optional; public models work without it)
HF_TOKEN=

# Tavily Search API key (optional; enables live GPU $/hr and model release radar)
TAVILY_API_KEY=

# NVIDIA NIM API key (optional; fallback live chat endpoint)
NVIDIA_NIM_KEY=

# ==============================================================================
# Strict Budget & Safety Guardrails ($35 Total Balance)
# ==============================================================================
# Overall hard spending cap across the entire project ($20 max out of $35 total)
MAX_BUDGET_USD=20.00

# Hard cap for any single benchmark / certification execution
MAX_PER_RUN_USD=10.00

# Execution mode: false = real Nebius Contree microVMs; true = deterministic simulator
USE_SIMULATOR=false

# Model configuration
CANDIDATE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
BASELINE_MODEL=Qwen3-8B
PLANNER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
CLASSIFIER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Web Frontend configuration (Next.js)
# BACKEND_API_URL: used at Next.js build time for /api/* proxy rewrites
# NEXT_PUBLIC_API: client-side API base URL
BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API=http://127.0.0.1:8000
